---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Academic Information System — Feri Juliansyah">

	<Navbar />

	<main class="project-page">

		<!-- HEADER -->

		<section class="project-hero">

			<div class="project-hero-meta">
				<span>01 — WEB APPLICATION</span>
				<span>2026</span>
			</div>

			<h1>
				ACADEMIC<br />
				<span>INFORMATION SYSTEM</span>
			</h1>

			<p class="project-hero-description">
				A web-based academic information system designed
				to help manage student data, attendance, grades,
				and academic reports.
			</p>

		</section>


		<!-- COVER -->

		<section class="project-cover">

			<img
				src="/images/projects/academic.png"
				alt="Academic Information System"
			/>

		</section>


		<!-- INFORMATION -->

		<section class="project-overview">

			<div class="section-number">
				01 — OVERVIEW
			</div>

			<div class="overview-grid">

				<div>
					<h2>
						Building a simpler
						academic workflow.
					</h2>
				</div>

				<div class="overview-content">

					<p>
						This project is a web-based academic
						information system developed to help
						manage academic activities at
						MDTA Raudhatul Jannah.
					</p>

					<p>
						The system centralizes student data,
						attendance, grades, and academic reports
						into a single platform, replacing
						manual data management processes.
					</p>

				</div>

			</div>

		</section>


		<!-- ROLE / TECHNOLOGY -->

		<section class="project-details-section">

			<div class="detail-block">

				<span>ROLE</span>

				<strong>
					Developer
				</strong>

			</div>

			<div class="detail-block">

				<span>TECHNOLOGY</span>

				<strong>
					CodeIgniter 3<br />
					PHP<br />
					MySQL<br />
					JavaScript
				</strong>

			</div>

			<div class="detail-block">

				<span>TYPE</span>

				<strong>
					Academic Information System
				</strong>

			</div>

		</section>


		<!-- FEATURES -->

		<section class="features-section">

			<div class="section-number">
				02 — FEATURES
			</div>

			<div class="features-grid">

				<div class="feature">
					<span>01</span>
					<h3>Student Management</h3>
					<p>
						Manage student profiles and academic
						information in one centralized system.
					</p>
				</div>

				<div class="feature">
					<span>02</span>
					<h3>Attendance</h3>
					<p>
						Teachers can record and manage
						student attendance digitally.
					</p>
				</div>

				<div class="feature">
					<span>03</span>
					<h3>Grades</h3>
					<p>
						Manage assignments, memorization,
						examination, and personality grades.
					</p>
				</div>

				<div class="feature">
					<span>04</span>
					<h3>Reports</h3>
					<p>
						Generate structured academic reports
						for students.
					</p>
				</div>

			</div>

		</section>

        <!-- GALLERY -->

        <section class="project-gallery">

            <div class="section-number">
                03 — INTERFACE
            </div>

            <div class="gallery-grid">

                <div class="gallery-item gallery-large">
                    <img
                        src="/images/projects/dashboard.png"
                        alt="Academic Information System dashboard"
                        loading="lazy"
                    />
                </div>

                <div class="gallery-item">
                    <img
                        src="/images/projects/students.png"
                        alt="Student management interface"
                        loading="lazy"
                    />
                </div>

                <div class="gallery-item">
                    <img
                        src="/images/projects/attendance.png"
                        alt="Student attendance interface"
                        loading="lazy"
                    />
                </div>

                <div class="gallery-item">
                    <img
                        src="/images/projects/grades.png"
                        alt="Student grades interface"
                        loading="lazy"
                    />
                </div>

                <div class="gallery-item">
                    <img
                        src="/images/projects/report.png"
                        alt="Academic report interface"
                        loading="lazy"
                    />
                </div>

            </div>

        </section>

		<!-- BACK -->

		<section class="project-navigation">

			<a href="/#projects">
				← Back to projects
			</a>

		</section>

	</main>

    <Footer />

</Layout>