---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="XEN — Utaite Website — Feri Juliansyah">

	<Navbar />

	<main class="project-page">

		<!-- HERO -->

		<section class="project-hero">

			<div class="project-hero-meta">
				<span>03 — PERSONAL WEBSITE</span>
				<span>2026</span>
			</div>

			<h1>
				XEN
			</h1>

			<p class="project-hero-description">
				A personal website for XEN, a mysterious vampire
				utaite persona, combining music, visual identity,
				and interactive web design into a single experience.
			</p>

		</section>


		<!-- COVER -->

		<section class="project-cover">

			<img
				src="/images/projects/xen.png"
				alt="XEN personal website"
			/>

		</section>


		<!-- OVERVIEW -->

		<section class="project-overview">

			<div class="section-number">
				01 — OVERVIEW
			</div>

			<div class="overview-grid">

				<div>
					<h2>
						A digital identity
						built around music.
					</h2>
				</div>

				<div class="overview-content">

					<p>
						XEN is a personal artist website created
						for a vampire utaite persona with a strong
						dark and luxurious visual identity.
					</p>

					<p>
						The website brings together the artist's
						profile, music, videos, schedule, and social
						media into a single digital experience.
					</p>

					<p>
						The focus was not only on presenting
						information, but also on creating a distinct
						atmosphere through typography, animation,
						and interaction.
					</p>

				</div>

			</div>

		</section>


		<!-- DETAILS -->

		<section class="project-details-section">

			<div class="detail-block">

				<span>ROLE</span>

				<strong>
					Designer & Developer
				</strong>

			</div>

			<div class="detail-block">

				<span>TECHNOLOGY</span>

				<strong>
					Astro<br />
					JavaScript<br />
					GSAP<br />
					Lenis<br />
					CSS
				</strong>

			</div>

			<div class="detail-block">

				<span>TYPE</span>

				<strong>
					Personal Artist Website
				</strong>

			</div>

		</section>


		<!-- FEATURES -->

		<section class="features-section">

			<div class="section-number">
				02 — FEATURES
			</div>

			<div class="features-grid">

				<div class="feature">

					<span>01</span>

					<h3>
						Artist Profile
					</h3>

					<p>
						A dedicated profile introducing XEN's
						character, identity, and artistic concept.
					</p>

				</div>


				<div class="feature">

					<span>02</span>

					<h3>
						Music
					</h3>

					<p>
						A music section presenting songs,
						artwork, artists, and listening links.
					</p>

				</div>


				<div class="feature">

					<span>03</span>

					<h3>
						Video
					</h3>

					<p>
						A dedicated space for music videos,
						covers, and other visual content.
					</p>

				</div>


				<div class="feature">

					<span>04</span>

					<h3>
						Interactive Design
					</h3>

					<p>
						Custom cursor effects, page transitions,
						scroll interactions, and subtle motion
						create a more immersive experience.
					</p>

				</div>


				<div class="feature">

					<span>05</span>

					<h3>
						Responsive Layout
					</h3>

					<p>
						The interface adapts to desktop and
						mobile screens while maintaining the
						visual identity.
					</p>

				</div>


				<div class="feature">

					<span>06</span>

					<h3>
						Visual Identity
					</h3>

					<p>
						Luxury typography, dark tones, red accents,
						and carefully controlled spacing establish
						a consistent artistic identity.
					</p>

				</div>

			</div>

		</section>


		<!-- GALLERY -->

		<section class="project-gallery">

			<div class="section-number">
				03 — INTERFACE
			</div>

			<div class="gallery-grid">

				<div class="gallery-item gallery-large">

					<img
						src="/images/projects/xen.png"
						alt="XEN homepage"
						loading="lazy"
					/>

				</div>


				<div class="gallery-item">

					<img
						src="/images/projects/profile.png"
						alt="XEN profile page"
						loading="lazy"
					/>

				</div>


				<div class="gallery-item">

					<img
						src="/images/projects/music.png"
						alt="XEN music page"
						loading="lazy"
					/>

				</div>


				<div class="gallery-item gallery-full">

					<img
						src="/images/projects/mobile.jpg"
						alt="XEN mobile interface"
						loading="lazy"
					/>

				</div>

			</div>

		</section>


		<!-- BACK -->

		<section class="project-navigation">

			<a href="/#projects">
				← Back to projects
			</a>

		</section>

	</main>

	<Footer />

</Layout>