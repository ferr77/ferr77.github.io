---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Yong Farm — Feri Juliansyah">

	<Navbar />

	<main class="project-page">

		<!-- HERO -->

		<section class="project-hero">

			<div class="project-hero-meta">
				<span>02 — BUSINESS MANAGEMENT SYSTEM</span>
				<span>2026</span>
			</div>

			<h1>
				YONG<br />
				<span>FARM</span>
			</h1>

			<p class="project-hero-description">
                A modern business management website combining
                a public-facing website with an administrative
                dashboard for managing products, pricing, and
                customer inquiries.
            </p>

		</section>


		<!-- COVER -->

		<section class="project-cover">

			<img
				src="/images/projects/yong.png"
				alt="Yong Farm website"
			/>

		</section>


		<!-- OVERVIEW -->

		<section class="project-overview">

			<div class="section-number">
				01 — OVERVIEW
			</div>

			<div class="overview-grid">

				<div>
					<h2>
                        A digital system
                        for a growing
                        business.
                    </h2>
				</div>

				<div class="overview-content">

                    <p>
                        Yong Farm is a web-based business system developed
                        to support both customer-facing information and
                        internal business management.
                    </p>

                    <p>
                        The public website allows customers to explore
                        products, view current egg prices, and get in
                        touch with the business.
                    </p>

                    <p>
                        Behind the website, an administrative dashboard
                        provides tools for managing products, prices,
                        and incoming customer information.
                    </p>

                </div>

			</div>

		</section>


		<!-- DETAILS -->

		<section class="project-details-section">

			<div class="detail-block">

				<span>ROLE</span>

				<strong>
					Designer & Developer
				</strong>

			</div>

			<div class="detail-block">

				<span>TECHNOLOGY</span>

				<strong>
					HTML<br />
					CSS<br />
					Tailwind CSS<br />
					PHP
				</strong>

			</div>

			<div class="detail-block">

				<span>TYPE</span>

				<strong>
                    Full-Stack Business System
                </strong>

			</div>

		</section>


		<!-- FEATURES -->

		<section class="features-section">

			<div class="section-number">
				02 — FEATURES
			</div>

			<div class="features-grid">

				<div class="feature">
                    <span>01</span>

                    <h3>
                        Product Management
                    </h3>

                    <p>
                        Administrators can manage products and
                        the information displayed on the public website.
                    </p>
                </div>

                <div class="feature">
                    <span>02</span>

                    <h3>
                        Price Management
                    </h3>

                    <p>
                        Manage and update current egg prices
                        through the administrative dashboard.
                    </p>
                </div>

                <div class="feature">
                    <span>03</span>

                    <h3>
                        Customer Inquiries
                    </h3>

                    <p>
                        Customer messages and order inquiries
                        can be managed from the dashboard.
                    </p>
                </div>

                <div class="feature">
                    <span>04</span>

                    <h3>
                        Admin Dashboard
                    </h3>

                    <p>
                        A centralized dashboard provides an overview
                        of the business data and management tools.
                    </p>
                </div>

                <div class="feature">
                    <span>05</span>

                    <h3>
                        Public Website
                    </h3>

                    <p>
                        A responsive interface presents products,
                        pricing, and business information to customers.
                    </p>
                </div>

                <div class="feature">
                    <span>06</span>

                    <h3>
                        Responsive Design
                    </h3>

                    <p>
                        The system is designed to work across
                        desktop and mobile devices.
                    </p>
                </div>

			</div>

		</section>


		<!-- GALLERY -->

		<section class="project-gallery">

			<div class="section-number">
				03 — INTERFACE
			</div>

			<div class="gallery-grid">

				<div class="gallery-item gallery-large">
					<img
						src="/images/projects/homepage.png"
						alt="Yong Farm homepage"
						loading="lazy"
					/>
				</div>

			</div>

		</section>


		<!-- BACK -->

		<section class="project-navigation">

			<a href="/#projects">
				← Back to projects
			</a>

		</section>

	</main>

    <Footer />

</Layout>